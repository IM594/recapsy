{
  "name": "@recapsy/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./storage/bun-sqlite-driver": {
      "types": "./src/storage/bun-sqlite-driver.ts",
      "import": "./src/storage/bun-sqlite-driver.ts"
    }
  },
  "dependencies": {
    "@recapsy/contracts": "workspace:*"
  },
  "scripts": {
    "test": "bun test src",
    "test:server-http": "bun test integration/server-http-smoke.test.ts",
    "test:capture-helper-process": "bun test integration/capture-helper-process.test.ts",
    "typecheck": "tsc --noEmit && pnpm run typecheck:integration",
    "typecheck:integration": "tsc --noEmit -p tsconfig.integration.json",
    "lint": "biome check src/ integration/",
    "check": "biome check src/ integration/",
    "build": "bun build src/main/electron-entry.ts --outdir dist/main --target node --external electron && bun build src/auth/login-window-preload.ts --outdir dist/auth --target node --format cjs --external electron",
    "start": "electron dist/main/electron-entry.js",
    "dev": "pnpm run build && pnpm run start"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^24.9.0",
    "electron": "^43.1.0"
  }
}
