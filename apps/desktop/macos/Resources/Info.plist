<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Source of truth for the capture bundle's identity (ADR 0009). The bundle
	  id is permanently frozen; changing it orphans the TCC grant and creates a
	  duplicate entry in the privacy panel. CFBundleName / CFBundleExecutable are
	  deliberately the product name "Recapsy" (not just CFBundleDisplayName),
	  because the screen-recording / accessibility panels display the executable
	  / bundle name, not the display name (ADR 0009 约束③).
	-->
	<key>CFBundleIdentifier</key>
	<string>one.recapsy.desktop.capture</string>
	<key>CFBundleName</key>
	<string>Recapsy</string>
	<key>CFBundleDisplayName</key>
	<string>Recapsy</string>
	<key>CFBundleExecutable</key>
	<string>Recapsy</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.0.1</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- Background agent: no Dock icon, no menu bar presence. -->
	<key>LSUIElement</key>
	<true/>
	<!--
	  User-visible screen-recording rationale. Must read as a first-class product
	  capability: no implementation words (helper / sidecar / subprocess) per the
	  naming rules and ADR 0009 用户可见性约束.
	-->
	<key>NSScreenCaptureUsageDescription</key>
	<string>Recapsy captures screenshots to build your private, searchable activity timeline.</string>
	<!--
	  Accessibility is used only for focused-window / context metadata sampling,
	  never for uploading AX subtree text. The usage string must stay product-
	  facing and must not invent implementation words.
	-->
	<key>NSAccessibilityUsageDescription</key>
	<string>Recapsy uses Accessibility to identify the active window and app context for your private timeline.</string>
</dict>
</plist>
