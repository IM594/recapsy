{
  "name": "recapsy-desktop",
  "productName": "Recapsy",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "pnpm build && electron-forge start",
