    "test": "vitest run",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@types/node": "24.13.3",
    "electron": "44.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
