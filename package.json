{
  "name": "recapsy",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "pnpm -r test",
    "lint": "biome ci .",
    "fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "prepare": "lefthook install"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "fs-xattr",
      "lefthook",
      "macos-alias"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "scope-empty": [
        2,
        "never"
      ],
      "body-empty": [
        2,
        "always"
      ],
      "footer-empty": [
        2,
        "always"
      ]
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "lefthook": "2.1.12"
  }
}
