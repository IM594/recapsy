{
  "name": "recapsy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "architecture:check": "dependency-cruise --config .dependency-cruiser.cjs apps/server/src apps/desktop/src packages/contracts/src",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "quality:changed-diff": "node scripts/check-changed-diff.mjs",
    "verify:goal": "git diff --check && pnpm quality:changed-diff && pnpm lint && pnpm typecheck && pnpm architecture:check && pnpm test && pnpm build",
    "verify:goal:macos": "pnpm --filter @recapsy/desktop run test:macos",
    "format": "biome format --write .",
    "check": "biome check .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "dependency-cruiser": "18.1.0",
    "lefthook": "^1.11.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron"]
  }
}
