{
  "name": "recapsy",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "biome ci .",
    "fix": "biome check --write .",
    "typecheck": "tsc",
    "prepare": "lefthook install"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "scope-empty": [
        2,
        "never"
      ],
      "body-empty": [
        2,
        "always"
      ],
      "footer-empty": [
        2,
        "always"
      ]
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/node": "24.13.3",
    "lefthook": "2.1.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
