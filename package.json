{
  "name": "recapsense",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:agent": "node apps/agent/src/server.mjs",
    "dev:mcp": "node apps/mcp/src/server.mjs",
    "dev:mcp:sse": "node apps/mcp/src/server-sse.mjs",
    "dev:app:macos": "swift run --package-path apps/app-macos",
    "dev:collector": "node scripts/collector.mjs",
    "seed": "node apps/agent/src/seed.mjs",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80"
  }
}
